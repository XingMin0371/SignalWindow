UPSTREAMS_FILE=./config/upstreams.json
ONEBOT_WS=ws://127.0.0.1:6199/ws
ONEBOT_TOKEN=
SELF_ID=
PRIVATE_USER_ID=
GROUP_ID=
PROFILE_LABEL=AstrBot
HOST=127.0.0.1
PORT=8787
# 留空仅允许 127.0.0.1/::1；HOST=0.0.0.0 时必须设置
GATEWAY_TOKEN=
DATA_DIR=./data
MAX_MESSAGES=4000
UPSTREAM_HOST_ALLOWLIST=
MAX_MEDIA_TOTAL_BYTES=536870912
MAX_MEDIA_FILES=5000
MAX_CLIENTS=100
MAX_CLIENTS_PER_IP=20
# 局域网默认关闭帧压缩以降低延迟；低带宽公网隧道可设为 1
WS_DEFLATE=0
# 可选：只允许这些远程媒体域名；留空表示保持兼容，不限制
MEDIA_HOST_ALLOWLIST=
